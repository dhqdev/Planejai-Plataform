# Respostas do install.sh para instalar sem perguntas (deploy/instalar-ssh.sh -r, instalar-ssh.ps1 -Respostas ou cloud-init).
# Copie para fora do repositório (ex.: ~/planejai-respostas.env), preencha e NÃO faça commit: tem senha e chave.
# Valor com espaço, $ ou #: entre aspas simples. Os segredos internos (ENCRYPTION_KEY etc.) o install.sh gera sozinho.

PLANEJAI_YES=1
# https = Caddy com certificado automático (domínio apontando para o servidor, portas 80/443)
# port = só a porta (atrás do seu proxy) | swarm = Swarm + Traefik (rede network_public) | portainer = só gera as variáveis
PLANEJAI_MODE=https
PLANEJAI_DOMAIN=planejai.seudominio.com
ADMIN_EMAIL=voce@exemplo.com
# vazio = o install.sh gera uma senha e mostra no fim
ADMIN_PASSWORD=
OPENROUTER_API_KEY=
OWNER_PHONES=5511999998888

# Opcionais
# PLANEJAI_SOURCE=ghcr          # ghcr = imagem pronta (amd64, arm64, armv7) | build = compilar no servidor
# PLANEJAI_PORT=3080            # modo port
# PLANEJAI_BROWSER=0            # deixa o navegador headless de fora (servidor com pouca memória)
# PLANEJAI_TAG=latest           # ou uma versão fixa, ex.: 1.2.150
# TRAEFIK_CERTRESOLVER=letsencryptresolver   # modo swarm
# PLANEJAI_DIR=/opt/planejai
