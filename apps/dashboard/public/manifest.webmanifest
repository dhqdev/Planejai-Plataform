{
  "name": "Planejai",
  "short_name": "Planejai",
  "description": "Painel do seu assistente no WhatsApp: gastos, lembretes, conversas e o time de agentes.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#f5f5f8",
  "theme_color": "#ff6d5a",
  "lang": "pt-BR",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Gastos", "url": "/finance", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lembretes", "url": "/reminders", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
