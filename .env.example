# ===== Planejai: variáveis de ambiente =====
# Copie para .env (dev) ou cadastre no Portainer (Stack > Environment variables).
# NUNCA commite o .env com valores reais.

# URL pública onde o app fica acessível (usada no webhook e no OAuth do Google)
PUBLIC_URL=https://planejai.seudominio.com
PLANEJAI_PORT=3080
PLANEJAI_TAG=latest

# Banco próprio da stack (serviço "db")
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Em dev fora do Docker:
DATABASE_URL=postgres://planejai:planejai@localhost:5432/planejai

# Segredo para criptografar credenciais e assinar sessões (mín. 32 caracteres).
# Gere com: openssl rand -hex 32
APP_SECRET=

# Login do dashboard
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# ===== WhatsApp =====
# baileys  = conexão própria por QR code / código de pareamento (padrão, tela "WhatsApp" do dashboard)
# evolution = Evolution API externa | cloud = API oficial da Meta | none
WHATSAPP_PROVIDER=baileys

# Evolution API v2
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=planejai

# WhatsApp Cloud API (Meta)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=

# Segredo do webhook da Evolution: use {PUBLIC_URL}/webhooks/evolution?secret=ESTE_VALOR
# Gere com: openssl rand -hex 16
WEBHOOK_SECRET=

# Números (com DDI, só dígitos, separados por vírgula) que falam com o agente sem aprovação
OWNER_PHONES=5519999999999
# true = qualquer número pode falar; false = novos ficam "aguardando aprovação" no dashboard
ALLOW_UNKNOWN_CONTACTS=false
DEFAULT_TIMEZONE=America/Sao_Paulo

# Navegador headless (serviço browserless da stack) para prints de páginas
BROWSERLESS_TOKEN=
# Chrome local para o navegador dos agentes em desenvolvimento (sem browserless)
CHROME_PATH=

# Redis próprio: memória curta das conversas. Mensagens ficam MESSAGE_RETENTION_HOURS (padrão 24h)
# e depois viram resumo; logs e gravações ficam EXECUTION_RETENTION_DAYS.
REDIS_URL=redis://localhost:6379
MESSAGE_RETENTION_HOURS=24
EXECUTION_RETENTION_DAYS=7
# Filas (como o modo fila do n8n): quantos jobs cada réplica do worker processa ao mesmo tempo
WORKER_CONCURRENCY=4

LOG_LEVEL=info
# Segundos esperando mensagens seguidas antes de responder
MESSAGE_DEBOUNCE_SECONDS=2
